# --- core ---
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.paymino.ir
#DATABASE_URL=postgres://paymino:STRONG_PASSWORD@localhost:5432/paymino
DATABASE_URL=sqlite:///db.sqlite3
# REDIS_URL=redis://localhost:6379/1     # optional; otherwise throttling uses a DB cache table

# --- public URLs ---
FRONTEND_URL=https://paymino.ir
API_PUBLIC_URL=https://api.paymino.ir
CORS_ALLOWED_ORIGINS=https://paymino.ir,https://www.paymino.ir
CSRF_TRUSTED_ORIGINS=https://api.paymino.ir
SESSION_COOKIE_DOMAIN=.paymino.ir
BEHIND_PROXY=1
TRUST_X_FORWARDED_FOR=1

# --- payments ---
PAYMENT_PROVIDER=plisio            # sandbox (dev only) | plisio
PLISIO_SECRET_KEY=your-plisio-secret-key
# PLISIO_EXPIRY_GRACE_MINUTES=60

# --- email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@paymino.ir
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Paymino <no-reply@paymino.ir>
